{
  "name": "todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "個人 Todo List — Cloudflare Workers + D1 + Supabase Auth (Google)，零 build",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 execute todo-db --local --file=./migrations/0001_create_todos.sql",
    "db:remote": "wrangler d1 execute todo-db --remote --file=./migrations/0001_create_todos.sql"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "vitest": "4.1.0",
    "wrangler": "^4.158.0"
  }
}
